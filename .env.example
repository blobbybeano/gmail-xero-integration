GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=google_token.json
GOOGLE_ADMIN_TOKEN_FILE=google_admin_token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_ADMIN_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive.metadata.readonly https://www.googleapis.com/auth/gmail.readonly
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback

XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8080/xero/callback
XERO_HTTPS_CERT=certs/localhost.crt
XERO_HTTPS_KEY=certs/localhost.key
XERO_TOKEN_FILE=xero_token.json
XERO_SCOPES=offline_access accounting.invoices accounting.payments accounting.contacts accounting.settings accounting.attachments accounting.banktransactions
# Optional local safety throttle. Fly uses 3 seconds to keep Xero calls paced.
XERO_MIN_REQUEST_INTERVAL_SECONDS=
# Calendar payment status is webhook-first. Leave the paid-status sweep at 0
# unless you deliberately want a small fallback poll of recent unpaid sent invoices.
PAID_SYNC_SWEEP_EVENTS_PER_CYCLE=0
HOURLY_RECONCILE_SECONDS=3600
HOURLY_RECONCILE_PAST_DAYS=14

KEYWORD=DONE
INVOICE_SEND_KEYWORD=SEND
DRY_RUN=true
STATE_FILE=state.json
POLL_SECONDS=30
RUN_ONCE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
WEB_SECRET_KEY=change-me
WEB_HOST=0.0.0.0
WEB_PORT=8080
ADMIN_DB_FILE=admin.db

# Receipt processing scaffold (off by default)
RECEIPTS_ENABLED=false
RECEIPTS_STORE_FILE=receipts_store.json
RECEIPTS_REQUIRE_WRITE_CONFIRMATION=true
RECEIPTS_UPLOAD_DIR=receipt_uploads
RECEIPTS_LINK_TTL_SECONDS=172800

# Cashflows reconciliation (preview/test mode by default)
CASHFLOWS_RECONCILE_DAYS=14
CASHFLOWS_RECONCILE_PRODUCTION=false
CASHFLOWS_CSV_SUBMIT_PRODUCTION=false
CASHFLOWS_RECONCILE_AI_ENABLED=false
CASHFLOWS_CLEARING_ACCOUNT_CODE=780
CASHFLOWS_BANK_FEES_ACCOUNT_CODE=404
CASHFLOWS_SETTLEMENTS_ACTION=GetSettlementPayouts
